<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.thevpc.naru</groupId>
    <artifactId>naru-agent-test</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>naru-agent-test</name>
    <description>Unit tests for Naru agent model interaction</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Naru API dependency -->
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-impl</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-fs</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-mcp</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-coder-java</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-shell</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-web</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-llm</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-routines</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-plan</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-sessions</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-tags</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-tasks</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-ai-models</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-index</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-index-java</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-git</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-semantic</artifactId><version>1.0.0.0</version></dependency>
        <dependency><groupId>net.thevpc.naru</groupId><artifactId>naru-tools-ollama</artifactId><version>1.0.0.0</version></dependency>


        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.6.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
        </plugins>
    </build>
</project>
